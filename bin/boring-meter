#!/bin/sh
# Boring Meter launcher for macOS, Linux and Git Bash on Windows.
# Finds a working Python 3.9+ and runs scripts/run_boring_meter.py.
SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET" ;;
  esac
done
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)

# Each candidate is actually run, because on Windows "python3" or "python" can be a
# Microsoft Store placeholder that exists on PATH but only prints an install hint.
PY=""
PY_FLAG=""
for CANDIDATE in python3 python py; do
  command -v "$CANDIDATE" >/dev/null 2>&1 || continue
  FLAG=""
  [ "$CANDIDATE" = "py" ] && FLAG="-3"
  if "$CANDIDATE" $FLAG -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    PY="$CANDIDATE"
    PY_FLAG="$FLAG"
    break
  fi
done

if [ -z "$PY" ]; then
  # Hooks must never fail Claude Code: without Python the hook simply does nothing.
  [ "${1:-}" = "--run-hook" ] && exit 0
  echo "Boring Meter error [RUNTIME_MISSING]: Python 3.9 or newer is required but was not found on PATH." >&2
  echo "Hint: install Python 3 (python.org, Homebrew, or your package manager), then run the command again." >&2
  exit 3
fi

exec "$PY" $PY_FLAG "$PLUGIN_ROOT/scripts/run_boring_meter.py" "$@"
